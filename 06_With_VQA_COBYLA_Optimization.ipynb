# Cell 6: WITH VQA - Variational Optimization Experiment

from scipy.optimize import minimize

vqa_results = []
vqa_convergence_history = {}

MAX_ITER = 200

print("=" * 90)
print("WITH VQA - VARIATIONAL OPTIMIZATION EXPERIMENT")
print("=" * 90)

print("Optimizer          : COBYLA")
print("Maximum Iterations :", MAX_ITER)
print("Random Seed        :", RANDOM_SEED)


for layers, circuit in circuits.items():

    print(f"\nRunning VQA for Configuration {layers}")
    print("-" * 70)

    initial_parameters = generate_initial_parameters(
        circuit.num_parameters,
        seed=RANDOM_SEED
    )

    energy_history = []
    iteration_counter = [0]

    def objective_function(parameters):

        energy = evaluate_energy(
            circuit,
            parameters,
            hamiltonian
        )

        iteration_counter[0] += 1
        energy_history.append(energy)

        return energy

    start_time = time.perf_counter()

    result = minimize(
        objective_function,
        initial_parameters,
        method="COBYLA",
        options={
            "maxiter": MAX_ITER,
            "rhobeg": 0.5,
            "tol": 1e-6
        }
    )

    execution_time = time.perf_counter() - start_time

    final_energy = result.fun

    energy_error = abs(
        final_energy - exact_ground_energy
    )

    vqa_convergence_history[layers] = energy_history

    vqa_results.append({
        "Configuration": layers,
        "Circuit Depth": circuit.depth(),
        "Layers": layers,
        "Total Gates": circuit.size(),
        "Parameters": circuit.num_parameters,
        "Iterations": iteration_counter[0],
        "Initial Energy": energy_history[0],
        "Final Energy": final_energy,
        "Energy Error": energy_error,
        "Execution Time (s)": execution_time,
        "Converged": result.success
    })

    print(f"  Circuit Depth : {circuit.depth()}")
    print(f"  Iterations    : {iteration_counter[0]}")
    print(f"  Initial Energy: {energy_history[0]:.8f}")
    print(f"  Final Energy  : {final_energy:.8f}")
    print(f"  Energy Error  : {energy_error:.8f}")
    print(f"  Time          : {execution_time:.4f} seconds")
    print(f"  Converged     : {result.success}")


vqa_df = pd.DataFrame(vqa_results)

print("\n" + "=" * 90)
print("WITH VQA RESULTS")
print("=" * 90)

display(vqa_df)
