# Cell 3: Parameterized Circuit Construction

from qiskit.circuit import ParameterVector

def create_parameterized_circuit(num_qubits=2, layers=1):

    qc = QuantumCircuit(num_qubits)

    theta = ParameterVector(
        "theta",
        length=2 * num_qubits * layers
    )

    parameter_index = 0

    for layer in range(layers):

        for qubit in range(num_qubits):
            qc.ry(theta[parameter_index], qubit)
            parameter_index += 1

            qc.rz(theta[parameter_index], qubit)
            parameter_index += 1

        for qubit in range(num_qubits - 1):
            qc.cx(qubit, qubit + 1)

    return qc


layers_list = [1, 2, 3, 4, 5]

circuits = {}

for layers in layers_list:
    circuits[layers] = create_parameterized_circuit(
        num_qubits=2,
        layers=layers
    )

print("=" * 80)
print("PARAMETERIZED CIRCUIT CONFIGURATIONS")
print("=" * 80)

for layers, circuit in circuits.items():
    print(
        f"Configuration {layers}: "
        f"Layers={layers}, "
        f"Qiskit Depth={circuit.depth()}, "
        f"Gates={circuit.size()}, "
        f"Parameters={circuit.num_parameters}"
    )

print("\nCircuit construction completed successfully.")
