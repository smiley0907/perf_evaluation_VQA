# Cell 5: WITHOUT VQA - Baseline Experiment

without_vqa_results = []

print("=" * 90)
print("WITHOUT VQA - BASELINE EXPERIMENT")
print("=" * 90)

for layers, circuit in circuits.items():

    initial_parameters = generate_initial_parameters(
        circuit.num_parameters,
        seed=RANDOM_SEED
    )

    start_time = time.perf_counter()

    energy = evaluate_energy(
        circuit,
        initial_parameters,
        hamiltonian
    )

    execution_time = time.perf_counter() - start_time

    energy_error = abs(
        energy - exact_ground_energy
    )

    without_vqa_results.append({
        "Configuration": layers,
        "Circuit Depth": circuit.depth(),
        "Layers": layers,
        "Total Gates": circuit.size(),
        "Parameters": circuit.num_parameters,
        "Energy": energy,
        "Energy Error": energy_error,
        "Execution Time (s)": execution_time
    })

    print(f"\nConfiguration {layers}")
    print(f"  Circuit Depth : {circuit.depth()}")
    print(f"  Gates         : {circuit.size()}")
    print(f"  Parameters    : {circuit.num_parameters}")
    print(f"  Energy        : {energy:.8f}")
    print(f"  Energy Error  : {energy_error:.8f}")
    print(f"  Time          : {execution_time:.6f} seconds")


without_vqa_df = pd.DataFrame(
    without_vqa_results
)

print("\n" + "=" * 90)
print("WITHOUT VQA RESULTS")
print("=" * 90)

display(without_vqa_df)
