# Cell 7: VQA vs. Without-VQA Comparative Analysis

without_vqa_compare = without_vqa_df.rename(
    columns={
        "Energy": "Energy_Without_VQA",
        "Energy Error": "Energy_Error_Without_VQA",
        "Execution Time (s)": "Execution_Time_Without_VQA"
    }
)

with_vqa_compare = vqa_df.rename(
    columns={
        "Final Energy": "Energy_With_VQA",
        "Energy Error": "Energy_Error_With_VQA",
        "Execution Time (s)": "Execution_Time_With_VQA"
    }
)

without_vqa_compare = without_vqa_compare[
    [
        "Configuration",
        "Circuit Depth",
        "Layers",
        "Total Gates",
        "Parameters",
        "Energy_Without_VQA",
        "Energy_Error_Without_VQA",
        "Execution_Time_Without_VQA"
    ]
]

with_vqa_compare = with_vqa_compare[
    [
        "Configuration",
        "Iterations",
        "Energy_With_VQA",
        "Energy_Error_With_VQA",
        "Execution_Time_With_VQA",
        "Converged"
    ]
]

comparison_df = without_vqa_compare.merge(
    with_vqa_compare,
    on="Configuration",
    how="inner"
)

comparison_df["Energy_Error_Reduction_%"] = (
    (
        comparison_df["Energy_Error_Without_VQA"]
        - comparison_df["Energy_Error_With_VQA"]
    )
    / comparison_df["Energy_Error_Without_VQA"]
) * 100

comparison_df["Execution_Time_Overhead_%"] = (
    (
        comparison_df["Execution_Time_With_VQA"]
        - comparison_df["Execution_Time_Without_VQA"]
    )
    / comparison_df["Execution_Time_Without_VQA"]
) * 100

comparison_df["Error_Improvement_Factor"] = (
    comparison_df["Energy_Error_Without_VQA"]
    / comparison_df["Energy_Error_With_VQA"]
)

comparison_df = comparison_df.round({
    "Energy_Without_VQA": 8,
    "Energy_With_VQA": 8,
    "Energy_Error_Without_VQA": 10,
    "Energy_Error_With_VQA": 10,
    "Energy_Error_Reduction_%": 4,
    "Execution_Time_Without_VQA": 6,
    "Execution_Time_With_VQA": 6,
    "Execution_Time_Overhead_%": 2,
    "Error_Improvement_Factor": 2
})

print("=" * 120)
print("VQA vs. WITHOUT VQA PERFORMANCE COMPARISON")
print("=" * 120)

display(comparison_df)
