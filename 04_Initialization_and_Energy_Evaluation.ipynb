# Cell 4: Common Initialization and Energy Evaluation

from qiskit.quantum_info import Statevector

RANDOM_SEED = 42


def generate_initial_parameters(
    num_parameters,
    seed=RANDOM_SEED
):
    rng = np.random.default_rng(seed)

    return rng.uniform(
        low=-np.pi,
        high=np.pi,
        size=num_parameters
    )


def evaluate_energy(
    circuit,
    parameters,
    hamiltonian
):

    parameter_values = {
        parameter: value
        for parameter, value in zip(
            circuit.parameters,
            parameters
        )
    }

    bound_circuit = circuit.assign_parameters(
        parameter_values
    )

    statevector = Statevector.from_instruction(
        bound_circuit
    )

    energy = statevector.expectation_value(
        hamiltonian
    )

    return float(np.real(energy))


print("=" * 80)
print("COMMON INITIALIZATION AND QUANTUM EVALUATION")
print("=" * 80)

print("Random Seed:", RANDOM_SEED)

print(
